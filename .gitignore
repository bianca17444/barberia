# ============================================================
# Qué NO se sube a GitHub
# ============================================================

# Librerías (se instalan con npm install) y archivos que se generan solos
node_modules/
.expo/
dist/
web-build/
*.log
.metro-health-check*

# Copias de seguridad locales
_respaldo_*/

# Claves y configuración local: nunca se suben (hay archivos .env.example de modelo)
.env
.env.*
!.env.example
*.local
.vercel/

# El APK pesa unos 70 MB: se descarga desde https://belabarberia.vercel.app
landing/descargas/*.apk

# Archivos de configuración de herramientas y del sistema
.claude/
.DS_Store
Thumbs.db
desktop.ini

# Archivos sensibles de compilación (firmas y certificados)
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
