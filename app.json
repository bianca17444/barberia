    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.barberia.imperial",
      "adaptiveIcon": {
        "backgroundColor": "#0c0e12",
