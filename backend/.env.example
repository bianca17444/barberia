# URL del proyecto de Supabase (Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave PÚBLICA de Supabase (sb_publishable_... o la anon legacy).
# La API NO usa la service_role: cada consulta se hace con el token del usuario,
# así las políticas RLS de la base se aplican también en el backend.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Orígenes web permitidos por CORS, separados por coma.
# La app móvil no envía Origin y siempre está permitida.
CORS_ORIGINS=http://localhost:5173,https://belabarberia.vercel.app

# Puerto local
PORT=3000
